# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Storage bucket name (create this in Supabase Storage)
SUPABASE_BUCKET=paper-duet-files

# Server
PORT=4000

# Where LibreOffice binary lives (default works on most Linux/Docker setups)
SOFFICE_PATH=soffice
